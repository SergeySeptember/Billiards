<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="Billiards.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelAndDto="clr-namespace:Billiards.ModelAndDto"
    xmlns:viewModels="clr-namespace:Billiards.ViewModels"
    x:DataType="viewModels:MainViewModel">

    <CarouselView ItemsSource="{Binding Pages}"
                  Position="{Binding CurrentIndex}"
                  IsSwipeEnabled="True">
        <CarouselView.ItemTemplate>
            <DataTemplate x:DataType="modelAndDto:MainCarouselItem">
                <ContentView Content="{Binding Content}" />
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView>
</ContentPage>
